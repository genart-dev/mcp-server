{
  "name": "@genart-dev/mcp-server",
  "version": "0.4.32",
  "description": "MCP server for genart.dev — tools, resources, and prompts for generative art",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "genart-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      },
      "require": {
        "types": "./dist/lib.d.cts",
        "default": "./dist/lib.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": {
    "name": "genart.dev",
    "email": "support@genart.dev",
    "url": "https://genart.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genart-dev/mcp-server.git"
  },
  "homepage": "https://genart.dev",
  "keywords": [
    "genart",
    "generative-art",
    "mcp",
    "model-context-protocol",
    "ai-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node --max-old-space-size=8192 node_modules/.bin/tsc --declaration --emitDeclarationOnly --outDir dist",
    "postbuild": "node -e \"const fs=require('fs'); ['dist/index.d.ts','dist/lib.d.ts'].forEach(f=>{if(!fs.existsSync(f)){console.error('ERROR: '+f+' missing — publish would break downstream builds'); process.exit(1)}}); console.log('Verified: DTS files present')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@genart-dev/core": "^0.6.4",
    "@genart-dev/plugin-animation": "^0.1.0",
    "@genart-dev/plugin-atmosphere": "^0.2.0",
    "@genart-dev/plugin-color-adjust": "^0.1.0",
    "@genart-dev/plugin-compositing": "^0.1.0",
    "@genart-dev/plugin-construction": "^0.1.0",
    "@genart-dev/plugin-distribution": "^0.1.0",
    "@genart-dev/plugin-figure": "^0.1.0",
    "@genart-dev/plugin-filters": "^0.1.0",
    "@genart-dev/plugin-identity": "^0.1.0",
    "@genart-dev/plugin-layout-composition": "^0.1.0",
    "@genart-dev/plugin-layout-guides": "^0.1.0",
    "@genart-dev/plugin-painting": "^0.3.0",
    "@genart-dev/plugin-particles": "^0.1.0",
    "@genart-dev/plugin-patterns": "^0.2.1",
    "@genart-dev/plugin-perspective": "^0.2.0",
    "@genart-dev/plugin-plants": "^0.3.1",
    "@genart-dev/plugin-poses": "^0.1.0",
    "@genart-dev/plugin-shapes": "^0.1.0",
    "@genart-dev/plugin-styles": "^0.1.0",
    "@genart-dev/plugin-symbols": "^0.1.0",
    "@genart-dev/plugin-terrain": "^0.4.0",
    "@genart-dev/plugin-textures": "^0.1.0",
    "@genart-dev/plugin-trace": "^0.1.0",
    "@genart-dev/plugin-typography": "^0.2.0",
    "@genart-dev/symbols": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "archiver": "^7.0.1",
    "puppeteer": "^24.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.2.3",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.1"
  }
}
